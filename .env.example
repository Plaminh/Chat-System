# Developer configuration. Copy to .env at the repository root and set the password.
# Docker Compose and the Java server both read this file, so it is the only file
# a developer edits. It overrides release/server.properties. Never commit .env.

# PostgreSQL role and database created when a new data volume is initialized.
POSTGRES_USER=chat_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=chat_system

# Loopback host port exposed by Docker Compose.
POSTGRES_PORT=55432

# Server only: where the Java server reaches PostgreSQL, and the TCP port it listens on.
POSTGRES_HOST=localhost
CHAT_SERVER_PORT=5050
