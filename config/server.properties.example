# Server configuration: PostgreSQL connection and the chat server TCP port.
# Edit only this file to run server.jar. Never commit the real password.
# Note: when a repository-root .env exists (developer setup), .env overrides this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=chat_system
POSTGRES_USER=chat_app
POSTGRES_PASSWORD=change-me
CHAT_SERVER_PORT=5050
