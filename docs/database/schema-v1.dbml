Project chat_system_v1 {
  database_type: 'PostgreSQL'
  Note: 'Version 1 physical model. Cross-table authorization and E2EE key management are deferred to Version 2.'
}

Table users {
  user_id bigint [pk, increment]
  username varchar(30) [not null, note: 'Case-insensitive unique expression index; 3-30 ASCII letters, digits, underscore']
  password_hash varchar(100) [not null]
  email varchar(254) [not null, note: 'Case-insensitive unique expression index']
  full_name varchar(100) [not null]
  address varchar(255) [not null]
  date_of_birth date [not null]
  gender varchar(10) [note: 'male, female, other, or NULL']
  role varchar(10) [not null, default: 'user']
  account_status varchar(10) [not null, default: 'active', note: 'active, locked, or deleted; deleted is terminal']
  locked_at timestamptz
  deleted_at timestamptz [note: 'Required only when account_status is deleted']
  password_changed_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table login_history {
  login_history_id bigint [pk, increment]
  user_id bigint [not null]
  logged_in_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  logged_out_at timestamptz
}

Table friend_requests {
  friend_request_id bigint [pk, increment]
  sender_user_id bigint [not null]
  receiver_user_id bigint [not null]
  status varchar(10) [not null, default: 'pending']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  responded_at timestamptz
}

Table friendships {
  friendship_id bigint [pk, increment]
  user_low_id bigint [not null]
  user_high_id bigint [not null]
  established_by_request_id bigint
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_low_id, user_high_id) [unique]
  }
}

Table user_blocks {
  user_block_id bigint [pk, increment]
  blocker_user_id bigint [not null]
  blocked_user_id bigint [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (blocker_user_id, blocked_user_id) [unique]
  }
}

Table conversations {
  conversation_id bigint [pk, increment]
  conversation_type varchar(10) [not null]
  name varchar(100)
  owner_user_id bigint
  encryption_enabled boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table direct_conversations {
  conversation_id bigint [pk]
  user_low_id bigint [not null]
  user_high_id bigint [not null]

  indexes {
    (user_low_id, user_high_id) [unique]
  }
}

Table conversation_members {
  conversation_member_id bigint [pk, increment]
  conversation_id bigint [not null]
  user_id bigint [not null]
  member_role varchar(10) [not null, default: 'member']
  joined_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  left_at timestamptz
  history_cleared_at timestamptz

  indexes {
    (conversation_id, user_id) [unique]
  }
}

Table messages {
  message_id bigint [pk, increment]
  conversation_id bigint [not null]
  sender_user_id bigint
  body text [not null, note: 'Recalled rows use the canonical [Message unsent] placeholder']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  unsent_at timestamptz
  unsent_by bigint
}

Table message_deletions {
  message_deletion_id bigint [pk, increment]
  message_id bigint [not null]
  user_id bigint [not null]
  deleted_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (message_id, user_id) [unique]
  }
}

Table spam_reports {
  spam_report_id bigint [pk, increment]
  reporter_user_id bigint
  reported_user_id bigint
  message_id bigint
  reason text [not null]
  review_status varchar(12) [not null, default: 'pending']
  reviewed_by bigint
  resolution_note text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  resolved_at timestamptz
}

Table user_activity_logs {
  user_activity_log_id bigint [pk, increment]
  user_id bigint [not null]
  activity_type varchar(12) [not null]
  conversation_id bigint
  occurred_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Ref: login_history.user_id > users.user_id [delete: cascade]
Ref: friend_requests.sender_user_id > users.user_id [delete: cascade]
Ref: friend_requests.receiver_user_id > users.user_id [delete: cascade]
Ref: friendships.user_low_id > users.user_id [delete: cascade]
Ref: friendships.user_high_id > users.user_id [delete: cascade]
Ref: friendships.established_by_request_id > friend_requests.friend_request_id [delete: set null]
Ref: user_blocks.blocker_user_id > users.user_id [delete: cascade]
Ref: user_blocks.blocked_user_id > users.user_id [delete: cascade]
Ref: conversations.owner_user_id > users.user_id [delete: restrict]
Ref: direct_conversations.conversation_id - conversations.conversation_id [delete: cascade]
Ref: direct_conversations.user_low_id > users.user_id [delete: restrict]
Ref: direct_conversations.user_high_id > users.user_id [delete: restrict]
Ref: conversation_members.conversation_id > conversations.conversation_id [delete: cascade]
Ref: conversation_members.user_id > users.user_id [delete: cascade]
Ref: messages.conversation_id > conversations.conversation_id [delete: cascade]
Ref: messages.sender_user_id > users.user_id [delete: set null]
Ref: messages.unsent_by > users.user_id [delete: set null]
Ref: message_deletions.message_id > messages.message_id [delete: cascade]
Ref: message_deletions.user_id > users.user_id [delete: cascade]
Ref: spam_reports.reporter_user_id > users.user_id [delete: set null]
Ref: spam_reports.reported_user_id > users.user_id [delete: set null]
Ref: spam_reports.message_id > messages.message_id [delete: set null]
Ref: spam_reports.reviewed_by > users.user_id [delete: set null]
Ref: user_activity_logs.user_id > users.user_id [delete: cascade]
Ref: user_activity_logs.conversation_id > conversations.conversation_id [delete: cascade]
