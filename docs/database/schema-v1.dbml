Project chat_system_v1 {
  database_type: 'PostgreSQL'
  Note: '''
  Version 1 physical model supporting client-side end-to-end encrypted groups with per-user recipient keys.

  Every column marked [increment] maps to PostgreSQL GENERATED BY DEFAULT AS IDENTITY. DBML does not distinguish that exact identity mode.

  Database constraints are modeled below. The following remain Version 2 application/transaction rules, not database constraints: deleted accounts are terminal; direct conversations have exactly two active members; group owners are active admins and ownership is transferred safely; message visibility combines membership intervals, clear-history, delete-for-me, and unsend state; authorization is enforced by the backend; User Clients retain private keys; public-key authenticity is verified; and group-key epochs/envelopes are generated and rotated atomically.
  '''
}

Table user_public_keys {
  user_public_key_id bigint [pk, increment]
  user_id bigint [not null]
  key_version int [not null]
  key_algorithm varchar(40) [not null, default: 'DHKEM-X25519-HKDF-SHA256']
  public_key_format varchar(20) [not null, default: 'RFC9180-RAW']
  public_key bytea [not null, note: '32-byte RFC 9180 DHKEM(X25519, HKDF-SHA256) serialized public key; private key remains on the User Client']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  retired_at timestamptz

  checks {
    `key_version > 0` [name: 'chk_user_public_keys_version']
    `key_algorithm = 'DHKEM-X25519-HKDF-SHA256'` [name: 'chk_user_public_keys_algorithm']
    `public_key_format = 'RFC9180-RAW'` [name: 'chk_user_public_keys_format']
    `octet_length(public_key) = 32` [name: 'chk_user_public_keys_material']
    `retired_at IS NULL OR retired_at >= created_at` [name: 'chk_user_public_keys_timestamps']
  }

  indexes {
    (user_id, key_version) [unique, name: 'uq_user_public_keys_user_version']
    (user_id, key_version [desc]) [name: 'idx_user_public_keys_user_history']
  }

  Note: '''
  PostgreSQL partial unique index not structurally representable in DBML:
  uq_user_public_keys_active_user on (user_id) WHERE retired_at IS NULL.

  V1 deliberately supports one active public key per user, not independent per-device keys.
  '''
}

Table users {
  user_id bigint [pk, increment]
  username varchar(30) [not null, note: 'Case-insensitive identity reserved by uq_users_username_ci even after soft delete']
  password_hash varchar(100) [not null]
  email varchar(254) [not null, note: 'Case-insensitive identity reserved by uq_users_email_ci even after soft delete']
  full_name varchar(100) [not null]
  address varchar(255) [not null]
  date_of_birth date [not null]
  gender varchar(10) [note: 'male, female, other, or NULL']
  role varchar(10) [not null, default: 'user']
  account_status varchar(10) [not null, default: 'active', note: 'active, locked, or deleted; terminal transition is enforced by the application, not by a database transition constraint']
  locked_at timestamptz
  deleted_at timestamptz [note: 'Required only when account_status is deleted; the row and its username/email identities are retained']
  password_changed_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `username ~ '^[A-Za-z0-9_]{3,30}$'` [name: 'chk_users_username']
    `length(btrim(password_hash)) >= 20` [name: 'chk_users_password_hash']
    `email ~ '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'` [name: 'chk_users_email']
    `length(btrim(full_name)) BETWEEN 2 AND 100` [name: 'chk_users_full_name']
    `length(btrim(address)) > 0` [name: 'chk_users_address']
    `date_of_birth < CURRENT_DATE` [name: 'chk_users_date_of_birth']
    `gender IS NULL OR gender IN ('male', 'female', 'other')` [name: 'chk_users_gender']
    `role IN ('admin', 'user')` [name: 'chk_users_role']
    `account_status IN ('active', 'locked', 'deleted')` [name: 'chk_users_account_status']
    `((account_status = 'active' AND locked_at IS NULL AND deleted_at IS NULL) OR (account_status = 'locked' AND locked_at IS NOT NULL AND deleted_at IS NULL) OR (account_status = 'deleted' AND locked_at IS NULL AND deleted_at IS NOT NULL))` [name: 'chk_users_lock_state']
    `updated_at >= created_at AND password_changed_at >= created_at` [name: 'chk_users_timestamps']
  }

  indexes {
    (`lower(username)`) [unique, name: 'uq_users_username_ci']
    (`lower(email)`) [unique, name: 'uq_users_email_ci']
    account_status [name: 'idx_users_account_status']
    (created_at [desc]) [name: 'idx_users_created_at']
    (`lower(full_name)`) [name: 'idx_users_full_name_ci']
  }
}

Table login_history {
  login_history_id bigint [pk, increment]
  user_id bigint [not null]
  logged_in_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  logged_out_at timestamptz

  checks {
    `logged_out_at IS NULL OR logged_out_at >= logged_in_at` [name: 'chk_login_history_timestamps']
  }

  indexes {
    (user_id, logged_in_at [desc]) [name: 'idx_login_history_user_time']
    (logged_in_at [desc]) [name: 'idx_login_history_logged_in_at']
  }
}

Table friend_requests {
  friend_request_id bigint [pk, increment]
  sender_user_id bigint [not null]
  receiver_user_id bigint [not null]
  status varchar(10) [not null, default: 'pending']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  responded_at timestamptz

  checks {
    `sender_user_id <> receiver_user_id` [name: 'chk_friend_requests_distinct_users']
    `status IN ('pending', 'accepted', 'declined', 'canceled')` [name: 'chk_friend_requests_status']
    `((status = 'pending' AND responded_at IS NULL) OR (status <> 'pending' AND responded_at IS NOT NULL))` [name: 'chk_friend_requests_response_state']
    `responded_at IS NULL OR responded_at >= created_at` [name: 'chk_friend_requests_timestamps']
  }

  indexes {
    (receiver_user_id, status, created_at [desc]) [name: 'idx_friend_requests_receiver_status_time']
    (sender_user_id, created_at [desc]) [name: 'idx_friend_requests_sender_time']
  }

  Note: '''
  PostgreSQL partial unique expression index not structurally representable in DBML:
  uq_friend_requests_pending_pair on (LEAST(sender_user_id, receiver_user_id), GREATEST(sender_user_id, receiver_user_id)) WHERE status = 'pending'.
  '''
}

Table friendships {
  friendship_id bigint [pk, increment]
  user_low_id bigint [not null]
  user_high_id bigint [not null]
  established_by_request_id bigint
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `user_low_id < user_high_id` [name: 'chk_friendships_canonical_pair']
  }

  indexes {
    (user_low_id, user_high_id) [unique, name: 'uq_friendships_pair']
    established_by_request_id [unique, name: 'uq_friendships_request']
    user_high_id [name: 'idx_friendships_user_high']
    (created_at [desc]) [name: 'idx_friendships_created_at']
  }
}

Table user_blocks {
  user_block_id bigint [pk, increment]
  blocker_user_id bigint [not null]
  blocked_user_id bigint [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `blocker_user_id <> blocked_user_id` [name: 'chk_user_blocks_distinct_users']
  }

  indexes {
    (blocker_user_id, blocked_user_id) [unique, name: 'uq_user_blocks_pair']
    blocked_user_id [name: 'idx_user_blocks_blocked_user']
    (created_at [desc]) [name: 'idx_user_blocks_created_at']
  }
}

Table conversations {
  conversation_id bigint [pk, increment]
  conversation_type varchar(10) [not null]
  name varchar(100)
  owner_user_id bigint
  encryption_enabled boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `conversation_type IN ('direct', 'group')` [name: 'chk_conversations_type']
    `((conversation_type = 'direct' AND name IS NULL AND owner_user_id IS NULL) OR (conversation_type = 'group' AND name IS NOT NULL AND owner_user_id IS NOT NULL AND length(btrim(name)) BETWEEN 1 AND 100))` [name: 'chk_conversations_shape']
    `updated_at >= created_at` [name: 'chk_conversations_timestamps']
    `conversation_type = 'group' OR NOT encryption_enabled` [name: 'chk_conversations_encryption_scope']
  }

  indexes {
    (conversation_id, encryption_enabled) [unique, name: 'uq_conversations_id_encryption']
    (conversation_type, created_at [desc]) [name: 'idx_conversations_type_created']
  }

  Note: '''
  PostgreSQL partial indexes not structurally representable in DBML:
  idx_conversations_group_name_ci on (lower(name)) WHERE conversation_type = 'group';
  idx_conversations_owner on (owner_user_id) WHERE owner_user_id IS NOT NULL.

  encryption_enabled is selected at group creation and is immutable by V2 server policy. The message composite FK checks stored-message consistency but is not a complete immutability constraint.
  '''
}

Table direct_conversations {
  conversation_id bigint [pk]
  user_low_id bigint [not null]
  user_high_id bigint [not null]

  checks {
    `user_low_id < user_high_id` [name: 'chk_direct_conversations_canonical_pair']
  }

  indexes {
    (user_low_id, user_high_id) [unique, name: 'uq_direct_conversations_pair']
    user_high_id [name: 'idx_direct_conversations_user_high']
  }
}

Table conversation_members {
  conversation_member_id bigint [pk, increment]
  conversation_id bigint [not null]
  user_id bigint [not null]
  member_role varchar(10) [not null, default: 'member']
  joined_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  left_at timestamptz
  history_cleared_at timestamptz

  checks {
    `member_role IN ('admin', 'member')` [name: 'chk_conversation_members_role']
    `((left_at IS NULL OR left_at >= joined_at) AND (history_cleared_at IS NULL OR history_cleared_at >= joined_at) AND (left_at IS NULL OR history_cleared_at IS NULL OR history_cleared_at <= left_at))` [name: 'chk_conversation_members_timestamps']
  }

  indexes {
    (conversation_id, user_id) [unique, name: 'uq_conversation_members_pair']
    (user_id, left_at, joined_at [desc]) [name: 'idx_conversation_members_user_history']
  }

  Note: '''
  PostgreSQL partial indexes not structurally representable in DBML:
  idx_conversation_members_user_active on (user_id, joined_at DESC) WHERE left_at IS NULL;
  idx_conversation_members_conversation_role_active on (conversation_id, member_role) WHERE left_at IS NULL.

  Membership reactivation and message visibility across joined_at, left_at, and history_cleared_at are application/transaction rules.
  '''
}

Table conversation_key_versions {
  conversation_key_version_id bigint [pk, increment]
  conversation_id bigint [not null]
  key_version int [not null]
  encryption_algorithm varchar(30) [not null, default: 'AES-256-GCM']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  retired_at timestamptz

  checks {
    `key_version > 0` [name: 'chk_conversation_key_versions_version']
    `encryption_algorithm = 'AES-256-GCM'` [name: 'chk_conversation_key_versions_algorithm']
    `retired_at IS NULL OR retired_at >= created_at` [name: 'chk_conversation_key_versions_timestamps']
  }

  indexes {
    (conversation_id, key_version) [unique, name: 'uq_conversation_key_versions_conversation_version']
  }

  Note: '''
  PostgreSQL partial index not structurally representable in DBML:
  idx_conversation_key_versions_active on (conversation_id, key_version DESC) WHERE retired_at IS NULL.

  This row identifies a client-generated group-key epoch; plaintext group-key material is never stored here.
  '''
}

Table conversation_key_envelopes {
  conversation_key_envelope_id bigint [pk, increment]
  conversation_key_version_id bigint [not null]
  recipient_public_key_id bigint [not null]
  envelope_algorithm varchar(64) [not null, default: 'HPKE-BASE-X25519-HKDF-SHA256-AES-256-GCM']
  encapsulated_key bytea [not null, note: '32-byte RFC 9180 HPKE encapsulated key']
  encrypted_group_key bytea [not null, note: '48-byte HPKE ciphertext for a 32-byte group key, including its 16-byte AEAD tag']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `envelope_algorithm = 'HPKE-BASE-X25519-HKDF-SHA256-AES-256-GCM'` [name: 'chk_conversation_key_envelopes_algorithm']
    `octet_length(encapsulated_key) = 32` [name: 'chk_conversation_key_envelopes_encapsulated_key']
    `octet_length(encrypted_group_key) = 48` [name: 'chk_conversation_key_envelopes_ciphertext']
  }

  indexes {
    (conversation_key_version_id, recipient_public_key_id) [unique, name: 'uq_conversation_key_envelopes_version_recipient']
    (recipient_public_key_id, conversation_key_version_id) [name: 'idx_conversation_key_envelopes_recipient']
  }

  Note: 'RFC 9180 base mode profile: KEM 0x0020, KDF 0x0001, AEAD 0x0002, UTF-8 info JavaChatSystem-V1-GroupKey. Canonical AAD binds conversation ID, epoch, recipient user ID, and recipient key version as documented in data-model.md. Membership authorization and envelope completeness are V2 transaction rules.'
}

Table messages {
  message_id bigint [pk, increment]
  conversation_id bigint [not null]
  sender_user_id bigint
  body text [note: 'Plaintext messages or non-null canonical [Message unsent] placeholder only; NULL only for sent encrypted content']
  content_encrypted boolean [not null, default: false]
  ciphertext bytea
  encryption_key_version int
  encryption_nonce bytea [note: 'Exactly 12 bytes for AES-GCM encrypted content; generated by the User Client for each encryption operation']
  authentication_tag bytea [note: 'Exactly 16 bytes for AES-GCM encrypted content']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  unsent_at timestamptz
  unsent_by bigint

  checks {
    `((unsent_at IS NULL AND unsent_by IS NULL AND ((NOT content_encrypted AND body IS NOT NULL AND length(btrim(body)) > 0 AND ciphertext IS NULL AND encryption_key_version IS NULL AND encryption_nonce IS NULL AND authentication_tag IS NULL) OR (content_encrypted AND body IS NULL AND ciphertext IS NOT NULL AND octet_length(ciphertext) > 0 AND encryption_key_version IS NOT NULL AND encryption_nonce IS NOT NULL AND octet_length(encryption_nonce) = 12 AND authentication_tag IS NOT NULL AND octet_length(authentication_tag) = 16))) OR (unsent_at IS NOT NULL AND unsent_at >= created_at AND body IS NOT NULL AND body = '[Message unsent]' AND ciphertext IS NULL AND encryption_key_version IS NULL AND encryption_nonce IS NULL AND authentication_tag IS NULL))` [name: 'chk_messages_content_state']
  }

  indexes {
    (conversation_id, created_at, message_id) [name: 'idx_messages_conversation_time']
  }

  Note: '''
  PostgreSQL partial indexes not structurally representable in DBML:
  idx_messages_sender_time on (sender_user_id, created_at DESC) WHERE sender_user_id IS NOT NULL.
  uq_messages_conversation_key_nonce unique on (conversation_id, encryption_key_version, encryption_nonce) WHERE content_encrypted AND encryption_key_version IS NOT NULL AND encryption_nonce IS NOT NULL.

  The nonce index detects duplicate retained rows for one conversation/key epoch; unsending clears nonce/key metadata, so correct client nonce handling remains mandatory. Unsend is distinct from per-user deletion and history clearing. Authorization and the atomic unsend update are application/transaction rules.
  '''
}

Table message_deletions {
  message_deletion_id bigint [pk, increment]
  message_id bigint [not null]
  user_id bigint [not null]
  deleted_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (message_id, user_id) [unique, name: 'uq_message_deletions_message_user']
    (user_id, deleted_at [desc]) [name: 'idx_message_deletions_user_time']
  }

  Note: 'Delete-for-me rows are independent of shared unsend state and conversation history clearing.'
}

Table spam_reports {
  spam_report_id bigint [pk, increment]
  reporter_user_id bigint
  reported_user_id bigint
  message_id bigint
  reason text [not null]
  review_status varchar(12) [not null, default: 'pending']
  reviewed_by bigint
  resolution_note text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  resolved_at timestamptz

  checks {
    `(reporter_user_id IS NULL OR reported_user_id IS NULL OR reporter_user_id <> reported_user_id)` [name: 'chk_spam_reports_distinct_users']
    `length(btrim(reason)) > 0` [name: 'chk_spam_reports_reason']
    `review_status IN ('pending', 'reviewing', 'resolved', 'dismissed')` [name: 'chk_spam_reports_status']
    `((review_status IN ('pending', 'reviewing') AND resolved_at IS NULL) OR (review_status IN ('resolved', 'dismissed') AND resolved_at IS NOT NULL))` [name: 'chk_spam_reports_resolution_state']
    `resolution_note IS NULL OR length(btrim(resolution_note)) > 0` [name: 'chk_spam_reports_resolution_note']
    `resolved_at IS NULL OR resolved_at >= created_at` [name: 'chk_spam_reports_timestamps']
  }

  indexes {
    (review_status, created_at [desc]) [name: 'idx_spam_reports_status_time']
  }

  Note: '''
  PostgreSQL partial indexes not structurally representable in DBML:
  idx_spam_reports_reported_user_time on (reported_user_id, created_at DESC) WHERE reported_user_id IS NOT NULL;
  idx_spam_reports_reporter_time on (reporter_user_id, created_at DESC) WHERE reporter_user_id IS NOT NULL;
  idx_spam_reports_reviewer on (reviewed_by) WHERE reviewed_by IS NOT NULL;
  idx_spam_reports_message on (message_id) WHERE message_id IS NOT NULL.
  '''
}

Table user_activity_logs {
  user_activity_log_id bigint [pk, increment]
  user_id bigint [not null]
  activity_type varchar(12) [not null]
  conversation_id bigint
  conversation_id_snapshot bigint [note: 'Immutable historical identifier; intentionally no foreign key']
  counterpart_user_id_snapshot bigint [note: 'Direct-chat other endpoint; immutable and intentionally no foreign key']
  occurred_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `activity_type IN ('app_open', 'direct_chat', 'group_chat')` [name: 'chk_user_activity_logs_type']
    `((activity_type = 'app_open' AND conversation_id IS NULL AND conversation_id_snapshot IS NULL AND counterpart_user_id_snapshot IS NULL) OR (activity_type = 'direct_chat' AND conversation_id_snapshot IS NOT NULL AND counterpart_user_id_snapshot IS NOT NULL AND counterpart_user_id_snapshot <> user_id AND (conversation_id IS NULL OR conversation_id = conversation_id_snapshot)) OR (activity_type = 'group_chat' AND conversation_id_snapshot IS NOT NULL AND counterpart_user_id_snapshot IS NULL AND (conversation_id IS NULL OR conversation_id = conversation_id_snapshot)))` [name: 'chk_user_activity_logs_context']
  }

  indexes {
    (user_id, occurred_at [desc]) [name: 'idx_user_activity_logs_user_time']
    (activity_type, occurred_at [desc], user_id) [name: 'idx_user_activity_logs_type_time']
  }

  Note: '''
  PostgreSQL partial index not structurally representable in DBML:
  idx_user_activity_logs_conversation_time on (conversation_id_snapshot, occurred_at DESC, user_id) WHERE conversation_id_snapshot IS NOT NULL.
  '''
}

Ref fk_login_history_user: login_history.user_id > users.user_id [delete: cascade, update: no action]
Ref fk_user_public_keys_user: user_public_keys.user_id > users.user_id [delete: cascade, update: no action]
Ref fk_friend_requests_sender: friend_requests.sender_user_id > users.user_id [delete: cascade, update: no action]
Ref fk_friend_requests_receiver: friend_requests.receiver_user_id > users.user_id [delete: cascade, update: no action]
Ref fk_friendships_user_low: friendships.user_low_id > users.user_id [delete: cascade, update: no action]
Ref fk_friendships_user_high: friendships.user_high_id > users.user_id [delete: cascade, update: no action]
Ref fk_friendships_request: friend_requests.friend_request_id - friendships.established_by_request_id [delete: set null, update: no action]
Ref fk_user_blocks_blocker: user_blocks.blocker_user_id > users.user_id [delete: cascade, update: no action]
Ref fk_user_blocks_blocked: user_blocks.blocked_user_id > users.user_id [delete: cascade, update: no action]
Ref fk_conversations_owner: conversations.owner_user_id > users.user_id [delete: restrict, update: no action]
Ref fk_direct_conversations_conversation: conversations.conversation_id - direct_conversations.conversation_id [delete: cascade, update: no action]
Ref fk_direct_conversations_user_low: direct_conversations.user_low_id > users.user_id [delete: restrict, update: no action]
Ref fk_direct_conversations_user_high: direct_conversations.user_high_id > users.user_id [delete: restrict, update: no action]
Ref fk_conversation_members_conversation: conversation_members.conversation_id > conversations.conversation_id [delete: cascade, update: no action]
Ref fk_conversation_members_user: conversation_members.user_id > users.user_id [delete: cascade, update: no action]
Ref fk_conversation_key_versions_conversation: conversation_key_versions.conversation_id > conversations.conversation_id [delete: cascade, update: no action]
Ref fk_conversation_key_envelopes_version: conversation_key_envelopes.conversation_key_version_id > conversation_key_versions.conversation_key_version_id [delete: cascade, update: no action]
Ref fk_conversation_key_envelopes_recipient_key: conversation_key_envelopes.recipient_public_key_id > user_public_keys.user_public_key_id [delete: restrict, update: no action]
Ref fk_messages_conversation: messages.conversation_id > conversations.conversation_id [delete: cascade, update: no action]
Ref fk_messages_conversation_encryption: (messages.conversation_id, messages.content_encrypted) > (conversations.conversation_id, conversations.encryption_enabled) [delete: cascade, update: no action]
Ref fk_messages_sender: messages.sender_user_id > users.user_id [delete: set null, update: no action]
Ref fk_messages_unsent_by: messages.unsent_by > users.user_id [delete: set null, update: no action]
Ref fk_messages_conversation_key_version: (messages.conversation_id, messages.encryption_key_version) > (conversation_key_versions.conversation_id, conversation_key_versions.key_version) [delete: restrict, update: no action]
Ref fk_message_deletions_message: message_deletions.message_id > messages.message_id [delete: cascade, update: no action]
Ref fk_message_deletions_user: message_deletions.user_id > users.user_id [delete: cascade, update: no action]
Ref fk_spam_reports_reporter: spam_reports.reporter_user_id > users.user_id [delete: set null, update: no action]
Ref fk_spam_reports_reported_user: spam_reports.reported_user_id > users.user_id [delete: set null, update: no action]
Ref fk_spam_reports_message: spam_reports.message_id > messages.message_id [delete: set null, update: no action]
Ref fk_spam_reports_reviewer: spam_reports.reviewed_by > users.user_id [delete: set null, update: no action]
Ref fk_user_activity_logs_user: user_activity_logs.user_id > users.user_id [delete: cascade, update: no action]
Ref fk_user_activity_logs_conversation: user_activity_logs.conversation_id > conversations.conversation_id [delete: set null, update: no action]
